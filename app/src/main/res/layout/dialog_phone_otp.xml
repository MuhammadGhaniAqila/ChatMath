<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_dialog_white"
    android:padding="22dp">

    <TextView
        android:id="@+id/textOtpTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Masukkan Nomor HP Anda"
        android:textColor="@color/primary"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textOtpSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="ChatMath akan mengirim kode verifikasi OTP 6-digit ke nomor Anda."
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textOtpTitle" />

    <!-- Step 1: Input Phone (Reference 03 style) & Name -->
    <LinearLayout
        android:id="@+id/layoutPhoneInputSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/textOtpSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/background_input"
                android:gravity="center"
                android:text="+62"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputOtpPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_input"
                android:hint="812 3456 7890"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />

        </LinearLayout>

        <EditText
            android:id="@+id/inputOtpName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_input"
            android:hint="Nama Tampilan (untuk pengguna baru)"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Step 2: Input 6-Digit OTP (Reference 04 style) -->
    <LinearLayout
        android:id="@+id/layoutOtpCodeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutPhoneInputSection">

        <TextView
            android:id="@+id/textOtpStatusInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_encryption_banner"
            android:gravity="center"
            android:padding="10dp"
            android:text="Kode OTP 6-digit telah dikirim."
            android:textColor="@color/encryption_banner_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputOtpCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/background_input"
            android:gravity="center"
            android:hint="• • • • • •"
            android:importantForAutofill="no"
            android:inputType="number"
            android:letterSpacing="0.35"
            android:maxLength="6"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressOtp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutOtpCodeSection" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/progressOtp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOtpCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:text="@string/cancel"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            app:cornerRadius="22dp"
            app:strokeColor="#D1D5DB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOtpAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary"
            android:text="Kirim OTP"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="22dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
