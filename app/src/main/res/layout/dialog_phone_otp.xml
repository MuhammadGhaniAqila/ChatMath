<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_dialog_white"
    android:padding="20dp">

    <TextView
        android:id="@+id/textOtpTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Login dengan Nomor HP (OTP)"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textOtpSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Masukkan nomor handphone aktif untuk menerima kode verifikasi OTP via Firebase Auth:"
        android:textColor="#4B5563"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textOtpTitle" />

    <!-- Step 1: Input Phone & Name -->
    <LinearLayout
        android:id="@+id/layoutPhoneInputSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/textOtpSubtitle">

        <EditText
            android:id="@+id/inputOtpPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_input"
            android:hint="Nomor HP (contoh: 08123456789)"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputOtpName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_input"
            android:hint="Nama Tampilan (untuk pengguna baru)"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Step 2: Input 6-Digit OTP -->
    <LinearLayout
        android:id="@+id/layoutOtpCodeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutPhoneInputSection">

        <TextView
            android:id="@+id/textOtpStatusInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_formula_box"
            android:padding="10dp"
            android:text="Kode OTP 6-digit telah dikirim."
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputOtpCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_input"
            android:gravity="center"
            android:hint="Masukkan 6 Digit Kode OTP"
            android:importantForAutofill="no"
            android:inputType="number"
            android:letterSpacing="0.2"
            android:maxLength="6"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressOtp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutOtpCodeSection" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/progressOtp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOtpCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:text="@string/cancel"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            app:cornerRadius="8dp"
            app:strokeColor="#D1D5DB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOtpAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary"
            android:text="Kirim OTP"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
